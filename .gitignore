
# ── MARK LVII — what never belongs in the repository ──────────────────────────
# Everything listed here is created by the app on first run. A fresh clone with
# none of it present boots straight to the setup screen, which is the intended
# first experience — so nothing here needs to be committed, and some of it must
# never be.

# ── Secrets. Committing any of these publishes them. ──────────────────────────
config/api_keys.json
config/api_keys*.json
config/.storage_key
config/.*key*
!config/*.example.json
config/security_policy.json
config/news_preferences.json
config/outages_cache.json
config/device_location.json
config/radio_state.json
config/zoxide_history.json
config/certs/
config/tv_certs/
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.bundle
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*

# ── Personal data the assistant accumulates about you ─────────────────────────
memory/long_term.json
memory/*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
memory/rag_index.json
memory/knowledge_index.json
memory/context_state.json
memory/security_state.json
memory/active_tasks.json
memory/model_benchmarks.json
memory/audit.log
memory/semantic_memory.json
memory/project_profiles.json
memory/ingestion_index.json
memory/knowledge_graph.json
memory/procedural_memory.json
memory/rag_chunks/
memory/embeddings/
config/voice_profiles/
config/speaker_models/
config/simulated_home_state.json
config/connected_devices.json
config/home_devices.json
config/home_routines.json
Desktop/

